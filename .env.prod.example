# ─── Base de datos ───────────────────────────────────────────────────────────
# Demo usa SQLite. Para prod con Postgres: postgresql+asyncpg://user:pass@host:5432/db
DATABASE_URL=sqlite+aiosqlite:///./bioshield.db

# ─── Seguridad ───────────────────────────────────────────────────────────────
# Generar: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_32_CHARS_MIN
# Generar: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AES_KEY=CHANGE_ME_FERNET_KEY
# Cloudflare Turnstile secret key (usa la test key para demo: 1x0000000000000000000000000000000AA)
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# ─── Gemini ──────────────────────────────────────────────────────────────────
GEMINI_API_KEY=CHANGE_ME
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# ─── ChromaDB ────────────────────────────────────────────────────────────────
CHROMA_PERSIST_DIRECTORY=/data/chroma_db

# ─── Embeddings locales (baked en la imagen Docker) ──────────────────────────
USE_LOCAL_EMBEDDINGS=true
BGE_MODEL_NAME=BAAI/bge-small-en-v1.5

# ─── CORS y URLs — actualizar con la URL del tunnel (Slice 2) ─────────────────
# Ejemplo: https://abc123.cfargotunnel.com
ALLOWED_ORIGINS=["https://TUNNEL_UUID.cfargotunnel.com"]
NEXT_PUBLIC_API_URL=https://TUNNEL_UUID.cfargotunnel.com/api
FRONTEND_URL=https://TUNNEL_UUID.cfargotunnel.com

# ─── Cloudflare Tunnel — obtener en Slice 2 del runbook ──────────────────────
CLOUDFLARE_TUNNEL_TOKEN=CHANGE_ME

# ─── Demo user ───────────────────────────────────────────────────────────────
# Obligatorio para make seed. Cambiar antes de producción real.
DEMO_USER_PASSWORD=CHANGE_ME_DEMO_PASSWORD

# ─── Opcionales ──────────────────────────────────────────────────────────────
DEBUG=false
DAILY_TOKEN_BUDGET=50000
